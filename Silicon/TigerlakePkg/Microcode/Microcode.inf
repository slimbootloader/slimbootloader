[Defines]
  INF_VERSION          = 0x00010005
  BASE_NAME            = Microcode
  FILE_GUID            = 5822532C-2C2C-4DA1-9688-009A56E939FD
  MODULE_TYPE          = USER_DEFINED
  VERSION_STRING       = 1.0
  DEFINE UCODE_NAME1   = m_80_806c1_000000bc
  DEFINE UCODE_NAME2   = m_c2_806d1_00000052

[Sources]
  $(UCODE_NAME1).mcb
  $(UCODE_NAME2).mcb

[UserExtensions.SBL."CloneRepo"]
